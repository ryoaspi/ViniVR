<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_/Project/Art/UI/uss/tablet-introduction-style.uss?fileID=7433441132597879392&amp;guid=8fa38adf001aa1a44b3ee3a5d544cfc9&amp;type=3#tablet-introduction-style"/>
    <ui:ScrollView name="scrollview-container" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
        <ui:VisualElement name="main-container" class="main-container" style="flex-grow: 1; align-items: center;">
            <ui:VisualElement name="container-content" class="container-content" style="flex-grow: 1;">
                <ui:Image source="project://database/Assets/_/Project/Art/UI/Icons/vinirVR-logo.svg?fileID=7388822144124034973&amp;guid=56775031771b334429553ad90e2bbe94&amp;type=3#vinirVR-logo" name="logo" class="logo"/>
                <ui:VisualElement name="container-title" class="container-title" style="align-self: center;">
                    <ui:Label text="2" name="1" class="title_1"/>
                    <ui:Label text="Pressurage" name="intro" class="title_intro" style="-unity-text-align: upper-left;"/>
                </ui:VisualElement>
                <ui:Label text="Le pressoir et la récolte du jus de presse" data-source-path="desc" name="desc" class="desc" style="height: 38px; margin-top: 259px;"/>
                <ui:Image name="separation_line" class="separation_line" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Images/separation_line.png?fileID=2800000&amp;guid=f971f82333425cf4bad5fc6570661032&amp;type=3#separation_line&quot;);"/>
                <ui:VisualElement name="container-instructions" class="container-instruction">
                    <ui:VisualElement name="illustration" class="illustration" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Images/photo_presse.png?fileID=2800000&amp;guid=4fc99c795ffbcb44e8015682e589b1bc&amp;type=3#photo_presse&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="container-mission" class="container-mission" style="flex-grow: 1;">
                    <ui:Label text="C&apos;est quoi le pressurage ?" name="mission-title" class="mission-title"/>
                    <ui:Label text="La machine que vous avez devant vous est un pressoir. Elle sert à extraire le jus des raisins, appelé le moût.&#10;&#10;Lors du pressurage, le moût est séparé des parties solides de la grappe : les peaux, les pépins et les rafles, c’est-à-dire les petites tiges qui relient les grains. Ces éléments peuvent apporter des arômes et de la structure, mais aussi de l’amertume s’ils sont pressés trop fortement.&#10;&#10;Pour produire un Crémant de Wallonie en Méthode Traditionnelle, le pressurage doit donc être lent, progressif et délicat. L’objectif est d’obtenir un jus clair, frais et équilibré, qui servira ensuite à produire le vin de base.&#10;&#10;La Méthode Traditionnelle repose sur une seconde fermentation en bouteille, selon le même principe que pour le Champagne. L’expression « méthode champenoise » est toutefois réservée aux vins bénéficiant de l’appellation Champagne, produits dans l’aire géographique délimitée de la Champagne." name="mission-text" class="mission-desc"/>
                    <ui:Label text="Tâches" name="actions-title" class="mission-title" style="white-space: pre; -unity-text-align: upper-left; align-self: flex-start; align-items: flex-start;">
                        <ui:VisualElement name="actions_list-container" class="actions_list-container action_list-container-first_child" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Pour commencer, allumez la machine en appuyant sur le bouton “START”." class="task-desc"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1; align-self: flex-start;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Une fois le pressoir allumé, les volets de remplissage s’ouvrent. Allez sur la plateforme et placer la trémie sur l’un des deux espaces de remplissage." enable-rich-text="false" class="task-desc" style="white-space: normal;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Prenez les bacs de raisins et versez les dans la trémie." class="task-desc"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Enlevez la trémie une fois le raisin versé." class="task-desc"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Activez la presse en appuyant sur &quot;Démarrer&quot; sur le panneau de controle. La presse va tourner et le jus va couler dans le bac en-dessous de la presse." class="task-desc" style="height: 37px; width: 753px; -unity-text-align: middle-left;"/>
                        </ui:VisualElement>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Button text="Passer à l&apos;étape suivante" name="button_press" enable-rich-text="false" class="button_start-game"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
