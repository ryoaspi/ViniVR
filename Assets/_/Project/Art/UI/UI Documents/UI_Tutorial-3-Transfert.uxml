<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_/Project/Art/UI/uss/tablet-introduction-style.uss?fileID=7433441132597879392&amp;guid=8fa38adf001aa1a44b3ee3a5d544cfc9&amp;type=3#tablet-introduction-style"/>
    <ui:ScrollView name="scrollview-container" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="align-self: center; align-content: auto; align-items: stretch;">
        <ui:VisualElement name="main-container" class="main-container" style="flex-grow: 1; align-items: auto;">
            <ui:VisualElement name="container-content" class="container-content" style="flex-grow: 1;">
                <ui:Image source="project://database/Assets/_/Project/Art/UI/Icons/vinirVR-logo.svg?fileID=7388822144124034973&amp;guid=56775031771b334429553ad90e2bbe94&amp;type=3#vinirVR-logo" name="logo" class="logo"/>
                <ui:VisualElement name="container-title" class="container-title" style="align-self: center;">
                    <ui:Label text="3" name="1" class="title_1"/>
                    <ui:Label text="Transfert" name="intro" class="title_intro" style="-unity-text-align: upper-left;"/>
                </ui:VisualElement>
                <ui:Label text="Transfert pour clarification" data-source-path="desc" name="desc" class="desc" style="height: 38px;"/>
                <ui:Image name="separation_line" class="separation_line" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Images/separation_line.png?fileID=2800000&amp;guid=f971f82333425cf4bad5fc6570661032&amp;type=3#separation_line&quot;);"/>
                <ui:VisualElement name="container-instructions" class="container-instruction">
                    <ui:VisualElement name="illustration" class="illustration" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Images/photo_pompe.png?fileID=2800000&amp;guid=9196a2ecc3a7fc4498cc3e2730c65597&amp;type=3#photo_pompe&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="container-mission" class="container-mission" style="flex-grow: 1;">
                    <ui:Label text="C&apos;est quoi le transfert ?" name="mission-title" class="mission-title"/>
                    <ui:Label text="Après le pressurage, le moût doit être transféré vers une cuve en inox pour poursuivre la vinification. Cette opération est réalisée à l’aide d’une pompe, reliée au pressoir et à la cuve par des tuyaux alimentaires.&#10;&#10;La pompe aspire le jus puis le pousse progressivement vers la cuve de débourbage. Elle permet d’assurer un transfert rapide et régulier, tout en limitant les manipulations. Selon le réglage et l’installation, elle peut atteindre un débit allant jusqu’à 150 hl par heure.&#10;&#10;&#10;Le moût peut alors commencer son débourbage, une étape de clarification durant laquelle les particules solides se déposent progressivement au fond de la cuve." name="mission-text" emoji-fallback-support="false" triple-click-selects-line="true" class="mission-desc" style="height: 438px;"/>
                    <ui:Label text="Tâches" name="actions-title" class="mission-title" style="white-space: pre; -unity-text-align: upper-left; align-self: flex-start; align-items: flex-start;">
                        <ui:VisualElement name="actions_list-container" class="actions_list-container action_list-container-first_child" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Pour commencer le transfert, connectez le tuyau d’aspiration à la cuve de récupération de jus de presse." class="task-desc"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1; align-self: flex-start;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Connectez l&apos;autre extrémité du tuyau à la pompe juste à côté." enable-rich-text="false" class="task-desc" style="white-space: normal;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1; align-self: flex-start;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Prenez l&apos;autre tuyau  et connectez l&apos;un des embouts à la sortie de la pompe." enable-rich-text="false" class="task-desc" style="white-space: normal;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1; align-self: flex-start;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Connectez l&apos;autre extrémité de ce tuyau au robinet de la cuve de débourbage." enable-rich-text="true" class="task-desc" style="white-space: normal;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Actionnez la vanne de la pompe et démarrez la. Vous verrez la jauge graduée de la cuve se remplir. C’est elle indique qui indique le taux de remplissage de la cuve. Une fois la cuve remplie, il va falloir attendre 48 heures pour que les levures commencent leur travail de vinification." class="task-desc"/>
                        </ui:VisualElement>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Button text="Passer à l&apos;étape suivante" name="button_transfert" enable-rich-text="false" class="button_start-game"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
