<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_/Project/Art/UI/uss/tablet-introduction-style.uss?fileID=7433441132597879392&amp;guid=8fa38adf001aa1a44b3ee3a5d544cfc9&amp;type=3#tablet-introduction-style"/>
    <ui:ScrollView name="scrollview-container" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="align-self: flex-end; align-items: stretch; justify-content: flex-start; align-content: flex-start;">
        <ui:VisualElement name="main-container" class="main-container" style="flex-grow: 1; align-items: auto;">
            <ui:VisualElement name="container-content" class="container-content" style="flex-grow: 1; align-self: center; align-content: flex-start;">
                <ui:Image source="project://database/Assets/_/Project/Art/UI/Icons/vinirVR-logo.svg?fileID=7388822144124034973&amp;guid=56775031771b334429553ad90e2bbe94&amp;type=3#vinirVR-logo" name="logo" class="logo"/>
                <ui:VisualElement name="container-title" class="container-title" style="align-self: center;">
                    <ui:Label text="6" name="1" class="title_1"/>
                    <ui:Label text="Fermentation alcoolique" name="intro" class="title_intro" style="-unity-text-align: upper-left;"/>
                </ui:VisualElement>
                <ui:Label text="Fermentation alcoolique par thermorégulation" data-source-path="desc" name="desc" class="desc" style="height: 38px;"/>
                <ui:Image name="separation_line" class="separation_line" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Images/separation_line.png?fileID=2800000&amp;guid=f971f82333425cf4bad5fc6570661032&amp;type=3#separation_line&quot;);"/>
                <ui:VisualElement name="container-instructions" class="container-instruction">
                    <ui:VisualElement name="illustration" class="illustration" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Images/photo_thermoregulation.png?fileID=2800000&amp;guid=a709ff4e18581bb4298dd8d091aa5270&amp;type=3#photo_thermoregulation&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="container-mission" class="container-mission" style="flex-grow: 1;">
                    <ui:Label text="C&apos;est quoi la fermentation alcoolique ?" name="mission-title" enable-rich-text="false" class="mission-title"/>
                    <ui:Label text="La fermentation alcoolique est l’étape durant laquelle les levures transforment les sucres naturellement présents dans le moût en alcool. Cette transformation produit également du gaz carbonique et de la chaleur.&#10;&#10;Dans une cuve en inox, la thermorégulation permet de maintenir une température stable pendant toute la fermentation. Pour un vin de base destiné au Crémant de Wallonie, on travaille généralement à température modérée afin de préserver la fraîcheur et les arômes délicats du raisin.&#10;&#10;Si la température monte trop, la fermentation peut devenir trop rapide et produire des arômes moins fins. À l’inverse, une température trop basse peut ralentir fortement l’activité des levures, voire interrompre la fermentation.&#10;&#10;L’inox est particulièrement adapté à cette étape : il est neutre, facile à nettoyer et permet un contrôle précis de la température. Cette maîtrise aide à obtenir un vin de base frais, équilibré et adapté à la future prise de mousse en Méthode Traditionnelle." name="mission-text" class="mission-desc"/>
                    <ui:Label text="Tâches" name="actions-title" class="mission-title" style="white-space: pre; -unity-text-align: upper-left; align-self: flex-start; align-items: flex-start;">
                        <ui:VisualElement name="actions_list-container" class="actions_list-container action_list-container-first_child" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Pour commencer, allumez la machine en appuyant sur le bouton “START”." class="task-desc"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1; align-self: flex-start;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Une fois le pressoir allumé, les volets de remplissage s’ouvrent. Allez sur la plateforme et placer la trémie sur l’un des deux espaces de remplissage." enable-rich-text="false" class="task-desc" style="white-space: normal;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Prenez les bacs de raisins et versez les dans la trémie." class="task-desc"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Enlevez la trémie une fois le raisin versé." class="task-desc"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="actions_list-container" class="actions_list-container" style="flex-grow: 1;">
                            <ui:Image class="task-icon" style="background-image: url(&quot;project://database/Assets/_/Project/Art/UI/Icons/task.svg?fileID=7388822144124034973&amp;guid=71d8f6c29fbbcbe48820a1fc58ca4bcb&amp;type=3#task&quot;);"/>
                            <ui:Label text="Activez la presse en appuyant sur &quot;Démarrer&quot; sur le panneau de controle. La presse va tourner et le jus va couler dans le bac en-dessous de la presse." class="task-desc" style="height: 37px; width: 753px; -unity-text-align: middle-left;"/>
                        </ui:VisualElement>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Button text="Passer à l&apos;étape suivante" name="button_fermentation" enable-rich-text="false" class="button_start-game"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
