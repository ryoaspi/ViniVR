:root {
}

.main-container {
    background-color: rgb(28, 3, 14);
    padding: 64px;
}

.container-content {
    border-width: 2px;
    border-color: rgba(218, 73, 93, 0.502);
    border-radius: 32px;
    color: rgb(255, 255, 255);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding: 64px;
}

.container-title {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    font-size: 32px;
    border-width: 2px;
    border-color: rgba(218, 73, 93, 0.5);
    border-radius: 32px;
    padding: 8px;
}

.logo {
    width: 100%;
    height: 250px;
    margin-bottom: 32px;
}

.title_1 {
    background-color: rgba(218, 73, 93, 0.5);
    padding: 9px 14px;
    border-radius: 64px;
    align-self: flex-start;
    font-size: 16px;
    -unity-font-style: bold;
}

.title_intro {
    align-self: flex-start;
    padding: 8px;
    font-size: 16px;
    -unity-font-style: bold;
}

.desc {
    margin-top: 16px;
    font-size: 32px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: lower-center;
}

.illustration {
    width: 836px;
    height: 470px;
    border-radius: 32px;
    border-width: 2px;
    border-color: rgb(218, 73, 93);
    display: flex;
    flex-direction: column;
    flex-grow: 0;
}

.container-instruction {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
}

.instruction-mission {
}

.mission-title {
}

.mission-desc {
    white-space: normal;
}

.separation_line {
    width: 400px;
    height: 30.5px;
    margin-top: 16px;
    margin-bottom: 16px;
}
